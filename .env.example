NODE_ENV=development

PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=mock_interview_ai
DB_USER=YOUR_NEW_DB_USER
DB_PASSWORD=YOUR_NEW_DB_PASSWORD

JWT_SECRET=CHANGE_THIS_TO_A_NEW_SECRET

# AI Configuration (Gemini API)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# Speech Configuration (Phase 5 Voice Mode)
SPEECH_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=YOUR_ASSEMBLYAI_API_KEY
SPEECH_LANGUAGE=en
SPEECH_TIMEOUT_MS=30000
MAX_RECORDING_SECONDS=120
MAX_AUDIO_FILE_SIZE_MB=15

TTS_PROVIDER=web_speech
TTS_LANGUAGE=en-US
TTS_TIMEOUT_MS=20000

